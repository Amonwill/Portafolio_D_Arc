---
// src/components/ProjectAside.astro
const { project, colors } = Astro.props;
---
<aside class="lg:col-span-5 lg:sticky lg:top-24 lg:h-[calc(100vh-140px)] flex flex-col overflow-hidden">
  <div class="mb-6 flex-none">
    <a href="/#gallery" class="group flex items-center gap-2 text-blue-500 font-mono text-[13px] uppercase tracking-widest hover:text-white transition-all">
      <span>❮</span> VOLVER A LA GALERÍA
    </a>
  </div>

  <div class="flex-1 overflow-y-auto custom-scrollbar bg-gray-900/10 rounded-2xl p-6 border border-white/5 shadow-inner overscroll-contain">
    <header class="mb-8">
      <p class="text-blue-400 font-mono text-xs uppercase mb-2 tracking-widest">{project.categoria}</p>
      <h1 class="text-5xl font-black italic uppercase leading-none tracking-tighter mb-4">{project.titulo}</h1>
      
      <div class="flex gap-4 mt-6 font-mono">
        <div class="flex flex-col">
          <span class="text-[9px] text-gray-500 uppercase tracking-widest">Estado_Doc</span>
          <span class={`text-[11px] uppercase ${project.estado === 'completado' ? 'text-green-500' : 'text-yellow-500'}`}>
            // {project.estado || 'En Proceso'}
          </span>
        </div>
        <div class="w-px h-8 bg-white/10"></div>
        <div class="flex flex-col">
          <span class="text-[9px] text-gray-500 uppercase tracking-widest">Versión_Sys</span>
          <span class="text-[11px] text-blue-400 uppercase">v{project.version || '1.0'}</span>
        </div>
      </div>
    </header>

    <section class="prose prose-invert mb-12 font-mono">
      <h2 class="text-[13px] text-gray-500 uppercase tracking-[0.4em] mb-4">Acerca del Proyecto</h2>
      <p class="text-gray-400 text-[17px] leading-relaxed italic">{project.descripcionLargo}</p>
    </section>

    {colors.length > 0 && (
      <div class="mt-8">
        <h4 class="font-mono text-[13px] text-gray-500 uppercase tracking-[0.3em] mb-4">Color Palette</h4>
        <div class="flex gap-3">
          {colors.map((color: any) => (
            <div class="group relative flex flex-col items-center">
              <div class="w-10 h-10 rounded-lg border border-white/10" style={{ backgroundColor: color.background }}></div>
              <span class="absolute -top-8 scale-75 opacity-0 group-hover:opacity-100 group-hover:scale-100 font-mono text-[10px] px-2 py-1 rounded transition-all z-50 border border-white/10" style={{ backgroundColor: color.background, color: color.foreground }}>
                {color.background}
              </span>
            </div>
          ))}
        </div>
      </div>
    )}
  </div>
</aside>