---
// src/components/Footer.astro
const currentYear = new Date().getFullYear();
---
<footer class="py-10 text-center border-t border-gray-900 bg-[#0a0a0a]">
  <div class="max-w-5xl mx-auto px-4">
    <div class="flex flex-col items-center gap-4">
      <span class="font-black italic text-xl tracking-tighter uppercase text-white">
        D_Arc<span class="text-blue-500">.</span>
      </span>
      
      <p class="text-gray-600 text-[10px] font-mono tracking-widest uppercase italic">
        &copy; {currentYear} // Jonathan Cruz Hernández // Built with Astro & Sanity
      </p>
      
      <div class="h-px w-12 bg-blue-500/30"></div>
    </div>
  </div>
</footer>