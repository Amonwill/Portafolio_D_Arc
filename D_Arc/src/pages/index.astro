---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import { sanityClient } from "sanity:client";
import imageUrlBuilder from '@sanity/image-url';

import Navbar from '../components/Navbar.astro';
import HeroSlider from '../components/HeroSlider.astro';
import Gallery from '../components/Gallery.astro';
import About from '../components/About.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';

const builder = imageUrlBuilder(sanityClient);
const urlFor = (source: any) => source ? builder.image(source) : null;

// FETCHING DATA
const dataDestacados = await sanityClient.fetch(`*[_type == "destacados"][0]{ proyectosDestacados[]->{ titulo, slug, categoria, procesoGaleria, "portada": procesoGaleria[-1] } }`);
const proyectos = await sanityClient.fetch(`*[_type == "proyecto" && defined(slug.current) && defined(procesoGaleria[0].asset)] | order(_createdAt desc){ titulo, slug, categoria, _createdAt, procesoGaleria, "portada": procesoGaleria[-1] }`);
const autor = await sanityClient.fetch(`*[_type == "author"][0]`);
const habilidadesData = await sanityClient.fetch(`*[_type == "habilidades"]{ nombre, icono }`);

const destacados = dataDestacados?.proyectosDestacados || proyectos.slice(0, 3);
---

<Layout title="Portafolio D_Arc">
  <main class="min-h-screen bg-[#0a0a0a] text-white font-sans pt-24 pb-20">
    <Navbar />
    <HeroSlider destacados={destacados} urlFor={urlFor} />
    <Gallery proyectos={proyectos} urlFor={urlFor} />
    <About autor={autor} habilidades={habilidadesData} proyectos={proyectos} urlFor={urlFor} />
    <Contact />
    <Footer />

    <script>
      // Importación modular de la lógica
      import { initSlider } from '../lib/slider';
      import { initFilters } from '../lib/filters';
      import { initContact } from '../lib/contact';

      // Inicialización en el cliente
      document.addEventListener('DOMContentLoaded', () => {
        initSlider();
        initFilters();
        initContact();

        // Lógica de Timeline (Experiencia) 
        const timelineBtn = document.getElementById('toggle-timeline');
        const timelineContent = document.getElementById('timeline-container');
        const timelineIcon = document.getElementById('timeline-icon');
        let isTimelineVisible = false;

        timelineBtn?.addEventListener('click', () => {
          isTimelineVisible = !isTimelineVisible;
          if(isTimelineVisible && timelineContent && timelineIcon && timelineBtn) {
            timelineContent.classList.remove('hidden');
            setTimeout(() => timelineContent.classList.add('opacity-100', 'translate-y-0'), 10);
            timelineIcon.classList.add('rotate-180');
            (timelineBtn.querySelector('span') as HTMLElement).innerText = "Ocultar Experiencia";
          } else if (timelineContent && timelineIcon && timelineBtn) {
            timelineContent.classList.remove('opacity-100', 'translate-y-0');
            timelineIcon.classList.remove('rotate-180');
            (timelineBtn.querySelector('span') as HTMLElement).innerText = "Ver Experiencia";
            setTimeout(() => { if(!isTimelineVisible) timelineContent.classList.add('hidden'); }, 500);
          }
        });
      });
    </script>
  </main>
</Layout>