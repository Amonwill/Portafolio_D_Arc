---
import Layout from '../../layouts/Layout.astro';
import { sanityClient } from "sanity:client";
import imageUrlBuilder from '@sanity/image-url';

const builder = imageUrlBuilder(sanityClient);
function urlFor(source: any) {
  return source ? builder.image(source) : null;
}

const { slug } = Astro.params;

// NAVEGACIÓN
const allProjects = await sanityClient.fetch(`*[_type == "proyecto"] | order(_createdAt desc) { "slug": slug.current }`);
const currentIndex = allProjects.findIndex((p: any) => p.slug === slug);
const prevProject = allProjects[currentIndex - 1]?.slug;
const nextProject = allProjects[currentIndex + 1]?.slug;

const project = await sanityClient.fetch(`
  *[_type == "proyecto" && slug.current == $slug][0] {
    titulo,
    categoria,
    descripcionLargo,
    procesoGaleria,
    estado,
    version,
    "palette": procesoGaleria[-1].asset->metadata.palette
  }
`, { slug });

if (!project) return Astro.redirect('/404');

const colors = project.palette ? [
  project.palette.vibrant,
  project.palette.darkVibrant,
  project.palette.lightVibrant,
  project.palette.muted,
  project.palette.darkMuted
].filter(Boolean) : [];
---

<Layout title={`${project.titulo} | D_Arc`}>
  <main class="min-h-screen bg-[#0a0a0a] text-white pt-24 pb-20 px-6">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      
      <!-- INFORMACIÓN DEL PROYECTO -->
      <aside class="lg:col-span-5 lg:sticky lg:top-24 lg:h-[calc(100vh-140px)] flex flex-col overflow-hidden">
        <div class="mb-6 flex-none">
          <a href="/#gallery" class="group flex items-center gap-2 text-blue-500 font-mono text-[13px] uppercase tracking-widest hover:text-white transition-all">
            <span>❮</span> VOLVER A LA GALERÍA
          </a>
        </div>
        <div class="flex-1 overflow-y-auto custom-scrollbar bg-gray-900/10 rounded-2xl p-6 border border-white/5 shadow-inner overscroll-contain">
          <header class="mb-8">
            <p class="text-blue-400 font-mono text-xs uppercase mb-2 tracking-widest">{project.categoria}</p>
            <h1 class="text-5xl font-black italic uppercase leading-none tracking-tighter mb-4">{project.titulo}</h1>
            <div class="h-1 w-20 bg-blue-600"></div>
          </header>
          <section class="prose prose-invert mb-12 font-mono">
            <h2 class="text-[13px] text-gray-500 uppercase tracking-[0.4em] mb-4">Acerca del Proyecto</h2>
            <p class="text-gray-400 text-[17px] leading-relaxed italic">{project.descripcionLargo}</p>
          </section>
          <!-- PALETA DE COLORES -->
          <div class="mt-8">
            <h4 class="font-mono text-[13px] text-gray-500 uppercase tracking-[0.3em] mb-4">Color Palette</h4>
            <div class="flex gap-3">
              {colors.map((color) => (
                <div class="group relative flex flex-col items-center">
                  <div class="w-10 h-10 rounded-lg border border-white/10" style={{ backgroundColor: color.background }}></div>
                  <span class="absolute -top-8 scale-75 opacity-0 group-hover:opacity-100 group-hover:scale-100 font-mono text-[10px] px-2 py-1 rounded transition-all z-50 border border-white/10" style={{ backgroundColor: color.background, color: color.foreground }}>
                    {color.background}
                  </span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </aside>
      <!-- PROCESO DE TRABAJO -->
      <div class="lg:col-span-7 space-y-32">
        {project.procesoGaleria?.map((paso: any, index: number) => (
          <div class="flex flex-col gap-6 items-center">
            <div class="w-full flex items-center gap-4 font-mono">
              <span class="text-xs text-blue-500">STEP_0{index + 1}</span>
              <h3 class="text-xl font-bold italic uppercase tracking-widest text-gray-200">{paso.descripcionPaso}</h3>
              <div class="flex-1 h-px bg-gray-800"></div>
            </div>
            <div class="relative w-full rounded-2xl overflow-hidden border border-gray-800 bg-gray-900 shadow-2xl flex justify-center cursor-zoom-in gallery-trigger group">
              <img src={urlFor(paso).width(1600).url()} class="w-full max-h-[90vh] object-contain group-hover:scale-[1.01] transition-transform duration-500" />
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- VISUALIZACIÓN FULLSCREEN -->
    <div id="project-modal" class="fixed inset-0 z-[100] bg-black/98 backdrop-blur-2xl hidden">
      <div class="absolute inset-0 pointer-events-none z-[130]">
        <!-- BOTÓN CERRAR -->
        <button id="close-modal" class="pointer-events-auto absolute top-8 left-8 text-white/50 hover:text-white font-mono text-[10px] tracking-widest bg-white/5 px-5 py-2 rounded-full border border-white/10 backdrop-blur-md transition-all active:scale-95 shadow-2xl">
          [ ESC ] CERRAR
        </button>
        <!-- NAVEGACIÓN -->
        {prevProject && (
          <a href={`/project/${prevProject}?view=modal`} class="pointer-events-auto absolute left-8 top-1/2 -translate-y-1/2 text-white/10 hover:text-blue-500 transition-all text-6xl font-thin select-none drop-shadow-lg">
            ❮
          </a>
        )}
        <!-- DERECHA -->
        <div class="absolute right-8 top-0 h-full flex flex-col justify-center items-center gap-12">
            <!-- MAIL -->
            <a 
              href={`mailto:jannasdcross@gmail.com?subject=Cotización: ${project.titulo}`} 
              class="pointer-events-auto group relative p-5 bg-blue-600/10 border border-blue-500/30 rounded-full hover:bg-blue-600 transition-all shadow-2xl shadow-blue-900/40"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-blue-400 group-hover:text-white">
                <rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
              </svg>
              <span class="absolute right-24 top-1/2 -translate-y-1/2 bg-blue-600 text-[10px] font-mono px-3 py-1 rounded opacity-0 group-hover:opacity-100 transition-all whitespace-nowrap tracking-[0.2em] uppercase shadow-xl">
                Request Commission
              </span>
            </a>
            <!-- SIGUIENTE -->
            {nextProject && (
              <a href={`/project/${nextProject}?view=modal`} class="pointer-events-auto text-white/10 hover:text-blue-500 transition-all text-6xl font-thin select-none drop-shadow-lg">
                ❯
              </a>
            )}
        </div>
      </div>
      <!-- CONTENIDO -->
      <div class="w-full h-full overflow-y-auto custom-scrollbar pt-32 pb-24 px-6 z-[120]">
        <div class="max-w-5xl mx-auto space-y-16 flex flex-col items-center">
          {project.procesoGaleria?.map((img: any) => (
            <img 
              src={urlFor(img).width(2000).url()} 
              class="w-full h-auto rounded-lg shadow-[0_0_80px_rgba(0,0,0,0.9)] border border-white/5" 
              alt="Full view"
            />
          ))}
          <!-- GENERACIÓN DE PALETA -->
          <div class="w-full mt-32 p-16 bg-white text-black rounded-sm shadow-[30px_30px_0px_#2563eb] font-mono select-text">
             <div class="flex justify-between border-b-4 border-black pb-6 mb-12">
                <div>
                  <h2 class="text-4xl font-black italic uppercase tracking-tighter">Reporte de Paleta</h2>
                  <p class="text-xs text-gray-400 font-bold uppercase tracking-widest">PROYECTO: {slug?.toUpperCase()}</p>
                </div>
                <div class="text-right">
                  <p class="text-[11px] font-black uppercase">Archivo de D Arc</p>
                  <p class="text-[11px] font-bold">{new Date().toLocaleDateString()}</p>
                </div>
             </div>
             <div class="grid grid-cols-2 md:grid-cols-5 gap-8">
                {colors.map((color) => (
                  <div class="flex flex-col gap-3 group">
                    <div class="h-32 w-full border border-black/10 shadow-inner transition-all hover:brightness-110" style={{ backgroundColor: color.background }}></div>
                    <p class="text-[12px] font-black tracking-tight">{color.background}</p>
                  </div>
                ))}
             </div>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>

<script>
  const modal = document.getElementById('project-modal');
  const closeBtn = document.getElementById('close-modal');
  const triggers = document.querySelectorAll('.gallery-trigger');

  const openModal = () => {
    if (modal) {
      modal.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
      modal.scrollTop = 0; 
    }
  };

  const closeModal = () => {
    if (modal) {
      modal.classList.add('hidden');
      document.body.style.overflow = 'auto';
      const url = new URL(window.location.href);
      url.searchParams.delete('view');
      window.history.replaceState({}, '', url);
    }
  };
  // EVENTOS
  triggers.forEach(t => t.addEventListener('click', openModal));
  closeBtn?.addEventListener('click', closeModal);
  // MODAL AUTOMÁTICO SI VIENE CON ?view=modal
  const checkParams = () => {
    const params = new URLSearchParams(window.location.search);
    if (params.get('view') === 'modal') {
      openModal();
    }
  };
  // CARGAR CONDICIONALMENTE
  checkParams();
  // ESC PARA CERRAR
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeModal();
  });
</script>

<style is:global>
  .custom-scrollbar::-webkit-scrollbar { width: 4px; }
  .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
  .custom-scrollbar::-webkit-scrollbar-thumb { background: #2563eb; border-radius: 10px; }
  .overscroll-contain { overscroll-behavior: contain; }
</style>